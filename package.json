{
  "name": "glorr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "glorr - 开源社区共创的 Florr 式多人实时花瓣对战游戏(致敬 florr.io,原创资产)",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "vite build",
    "build:pages": "vite build --outDir ../../docs --emptyOutDir",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-bot.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
